{
  "name": "payment-proccesor",
  "license": "UNLICENSED",
  "scripts": {
    "clean": "rm -rf build generated",
    "prepare:localhost": "mustache config/localhost.json subgraph.template.yaml > subgraph.yaml",
    "prepare:base-sepolia": "mustache config/base-sepolia.json subgraph.template.yaml > subgraph.yaml",
    "codegen": "graph codegen",
    "build": "graph build",
    "deploy": "graph deploy --node https://api.studio.thegraph.com/deploy/ payment-processor",
    "deploy:full": "./scripts/deploy-subgraph.sh",
    "create-local": "graph create --node http://localhost:8020/ payment-processor",
    "remove-local": "graph remove --node http://localhost:8020/ payment-processor",
    "deploy-local": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 payment-processor",
    "test": "graph test"
  },
  "dependencies": {
    "@graphprotocol/graph-cli": "0.98.1",
    "@graphprotocol/graph-ts": "0.38.2"
  },
  "devDependencies": {
    "matchstick-as": "0.6.0",
    "mustache": "^4.2.0"
  }
}
